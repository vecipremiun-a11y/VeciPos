{
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "framework": "vite",
    "functions": {
        "api/**/*.js": {
            "memory": 256,
            "maxDuration": 30
        }
    },
    "rewrites": [
        {
            "source": "/api/external/products",
            "destination": "/api/external/products"
        },
        {
            "source": "/api/external/ping",
            "destination": "/api/external/ping"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/api/external/(.*)",
            "headers": [
                { "key": "Cache-Control", "value": "no-store, max-age=0" }
            ]
        }
    ]
}